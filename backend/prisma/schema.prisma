generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  outdoors
  nights_out
  food_and_drink
  classes
  other
}

enum Illustration {
  kayak
  hike
  speakeasy
  salsa
  market
  pottery
  other
}

enum BookingStatus {
  confirmed
  cancelled
}

enum Rail {
  vouch
  public
}

enum Platform {
  web
  mobile
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  displayName     String   @map("display_name")
  contactHmac     String?  @unique @map("contact_hmac")
  generation      Int      @default(0)
  remindDayBefore Boolean  @default(true) @map("remind_day_before")
  friendUpdates   Boolean  @default(false) @map("friend_updates")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hostedActivities Activity[]
  plans            Plan[]
  bookings         Booking[]
  sentInvites      Invite[]       @relation("inviter")
  attributionsSent Attribution[]  @relation("attributionInviter")
  attributions     Attribution[]  @relation("attributionInvitee")
  events           Event[]
  flagExposures    FlagExposure[]
  spotWatches      SpotWatch[]

  @@map("users")
}

model Activity {
  id           String       @id @default(uuid()) @db.Uuid
  hostId       String       @map("host_id") @db.Uuid
  title        String
  description  String
  category     Category
  illustration Illustration
  location     String
  startsAt     DateTime     @map("starts_at") @db.Timestamptz(3)
  timezone     String
  priceMinor   Int          @map("price_minor")
  currency     String       @db.Char(3)
  capacity     Int
  spotsTaken   Int          @default(0) @map("spots_taken")
  version      Int          @default(1)
  flagBucket   Int          @default(-1) @map("flag_bucket")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  host          User            @relation(fields: [hostId], references: [id])
  plans         Plan[]
  bookings      Booking[]
  invites       Invite[]
  photos        ActivityPhoto[]
  events        Event[]
  flagExposures FlagExposure[]
  spotWatches   SpotWatch[]

  @@index([startsAt])
  @@index([hostId])
  @@map("activities")
}

model ActivityPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  url        String
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, position])
  @@map("activity_photos")
}

model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  ownerId    String   @map("owner_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  activity     Activity      @relation(fields: [activityId], references: [id])
  owner        User          @relation(fields: [ownerId], references: [id])
  bookings     Booking[]
  invites      Invite[]
  attributions Attribution[]

  @@index([activityId])
  @@index([ownerId])
  @@map("plans")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid
  activityId     String        @map("activity_id") @db.Uuid
  planId         String        @map("plan_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  status         BookingStatus @default(confirmed)
  inviteId       String?       @map("invite_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key")
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  activity    Activity     @relation(fields: [activityId], references: [id])
  plan        Plan         @relation(fields: [planId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  invite      Invite?      @relation(fields: [inviteId], references: [id])
  attribution Attribution?

  @@unique([userId, idempotencyKey])
  @@index([activityId, status])
  @@index([planId])
  @@index([userId])
  @@map("bookings")
}

model Invite {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  rail           Rail
  inviterId      String   @map("inviter_id") @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  planId         String?  @map("plan_id") @db.Uuid
  recipientHmac  String?  @map("recipient_hmac")
  recipientLabel String?  @map("recipient_label")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inviter      User               @relation("inviter", fields: [inviterId], references: [id])
  activity     Activity           @relation(fields: [activityId], references: [id])
  plan         Plan?              @relation(fields: [planId], references: [id])
  revocations  InviteRevocation[]
  attributions Attribution[]
  bookings     Booking[]
  events       Event[]

  @@index([inviterId, activityId])
  @@index([activityId])
  @@map("invites")
}

model InviteRevocation {
  id        String   @id @default(uuid()) @db.Uuid
  inviteId  String   @map("invite_id") @db.Uuid
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invite Invite @relation(fields: [inviteId], references: [id])

  @@index([inviteId])
  @@map("invite_revocations")
}

model Attribution {
  id            String   @id @default(uuid()) @db.Uuid
  inviteId      String   @map("invite_id") @db.Uuid
  rail          Rail
  code          String
  inviterId     String   @map("inviter_id") @db.Uuid
  inviteeId     String   @map("invitee_id") @db.Uuid
  inviteeWasNew Boolean  @map("invitee_was_new")
  hopGeneration Int      @map("hop_generation")
  planId        String   @map("plan_id") @db.Uuid
  bookingId     String   @unique @map("booking_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invite  Invite  @relation(fields: [inviteId], references: [id])
  inviter User    @relation("attributionInviter", fields: [inviterId], references: [id])
  invitee User    @relation("attributionInvitee", fields: [inviteeId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([inviteId])
  @@index([inviterId])
  @@index([inviteeId])
  @@map("attributions")
}

model Event {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  userId     String?   @map("user_id") @db.Uuid
  anonId     String?   @map("anon_id")
  platform   Platform?
  activityId String?   @map("activity_id") @db.Uuid
  inviteId   String?   @map("invite_id") @db.Uuid
  rail       Rail?
  props      Json      @default("{}")

  user     User?     @relation(fields: [userId], references: [id])
  activity Activity? @relation(fields: [activityId], references: [id])
  invite   Invite?   @relation(fields: [inviteId], references: [id])

  @@index([name, occurredAt])
  @@index([inviteId])
  @@index([activityId])
  @@map("events")
}

model FlagExposure {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  anonId     String?  @map("anon_id")
  activityId String   @map("activity_id") @db.Uuid
  flag       String
  variant    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User?    @relation(fields: [userId], references: [id])
  activity Activity @relation(fields: [activityId], references: [id])

  @@index([activityId, flag])
  @@map("flag_exposures")
}

model SpotWatch {
  id          String   @id @default(uuid()) @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  anonId      String?  @map("anon_id")
  contactHmac String?  @map("contact_hmac")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([activityId])
  @@map("spot_watches")
}

model FeatureFlag {
  key            String   @id
  enabled        Boolean  @default(true)
  rolloutPercent Int      @default(100) @map("rollout_percent")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}
