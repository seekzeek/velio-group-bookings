# Copy to .env. Nothing here is secret in development, but real deployments generate their own values.

# Postgres from docker compose. Tests use TEST_DATABASE_URL instead and never touch this database.
DATABASE_URL=postgresql://velio:velio@localhost:5432/velio
# Database the tests create and migrate for themselves.
TEST_DATABASE_URL=postgresql://velio:velio@localhost:5432/velio_test
# Redis from docker compose. Tests use logical database 1.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1
# Prefix for pub/sub channels. Pub/sub ignores Redis logical databases, so tests use their own prefix.
REDIS_CHANNEL_PREFIX=velio
# Second database that holds the 30-day Part 4 scenario. Optional; /admin/health?source=scenario reads it.
# SCENARIO_DATABASE_URL=postgresql://velio:velio@localhost:5432/velio_scenario

# Port the API listens on.
PORT=4000
# Browser origins allowed by CORS, comma separated. The SSE stream is opened from the browser directly.
WEB_ORIGIN=http://localhost:3000
# Base of the invite links we hand out, so /i/<code> opens the web app.
PUBLIC_WEB_URL=http://localhost:3000
# Base used to build photo URLs served from /uploads.
PUBLIC_API_URL=http://localhost:4000

# Secret for hashing contacts. Rotating it makes every stored vouch unmatchable, so treat it like a password.
CONTACT_HMAC_SECRET=change-me-to-a-long-random-string
# Salt for the per-activity feature flag bucket. Changing it reshuffles the holdout, so never change it after launch.
FLAG_SALT=velio-invites-2026
# Region used to parse phone numbers typed without a country code.
DEFAULT_PHONE_REGION=US

# pino level: trace, debug, info, warn, error.
LOG_LEVEL=info
# Postgres pool size. The concurrency test raises it above the number of parallel requests.
PG_POOL_MAX=10
# Interactive transaction timeout for the booking path. Timeouts return 503 TRY_AGAIN.
BOOKING_TX_TIMEOUT_MS=5000
# Folder photos are written to and served from.
UPLOADS_DIR=uploads
# Per-IP, per-code and per-user limits from API.md. Turn off for load tests from one machine.
RATE_LIMIT_ENABLED=true

# Database the load test seeds and books against. Must end with _load. Start a second backend on it for the k6 run (see README).
LOAD_DATABASE_URL=postgresql://velio:velio@localhost:5432/velio_load
